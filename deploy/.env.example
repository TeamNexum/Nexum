# Copy to deploy/.env (git-ignored) and fill in. Never commit the real values.

# Public domain of the API, pointing at the server (A/AAAA record).
# Use "localhost" to try the stack on your machine.
NEXUM_DOMAIN=api.example.com

# JWT signing secret. Generate one with: openssl rand -base64 48
NEXUM_JWT_SECRET=

# PostgreSQL password. Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Discord webhook for beta feedback (optional; /api/feedback answers 503 without it).
NEXUM_FEEDBACK_WEBHOOK=

# Only used by images built with FEATURES=claude.
ANTHROPIC_API_KEY=

# Image tag to run (a commit SHA in production; "latest" by default).
NEXUM_CLOUD_TAG=latest
